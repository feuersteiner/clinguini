{
	"name": "clinguini",
	"version": "0.1.0",
	"description": "A very tiny CLI builder. Native TypeScript, Node.js compatible, zero runtime dependencies.",
	"type": "module",
	"exports": "./index.ts",
	"files": [
		"index.ts",
		"types.ts",
		"parsers.ts",
		"args"
	],
	"engines": {
		"node": ">=22"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/feuersteiner/clinguini.git"
	},
	"homepage": "https://github.com/feuersteiner/clinguini#readme",
	"bugs": {
		"url": "https://github.com/feuersteiner/clinguini/issues"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"packageManager": "bun@1.3.4",
	"scripts": {
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "node --test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-check-file": "^3.3.2",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1"
	}
}
