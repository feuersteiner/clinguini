{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"types": ["node"],
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"noEmit": true
	},
	"include": ["*.ts", "args/**/*.ts", "cli/**/*.ts", "tests/**/*.ts"]
}
